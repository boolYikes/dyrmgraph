<?xml version="1.0"?>

<ruleset name="dyrmgraph"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">

    <description>Dyrmgraph PMD rules</description>

    <rule ref="rulesets/java/quickstart.xml">
        <exclude name="VariableCanBeInlined"/>
    </rule>
    
    <rule ref="category/java/codestyle.xml">
        <exclude name="MethodArgumentCouldBeFinal"/>
        <exclude name="LocalVariableCouldBeFinal"/>
        <exclude name="VariableCanBeInlined"/>
        <exclude name="CommentDefaultAccessModifier"/>
        <exclude name="ShortVariable"/>
        <exclude name="ShortClassName"/>
    </rule>

</ruleset>